<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
    <style>
      :root {
        color-scheme: light dark;
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      body {
        margin: 0;
        padding: 0;
        line-height: 1.6;
        background: #0f172a;
        color: #e2e8f0;
      }
      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem 1.5rem;
        background: rgba(15, 23, 42, 0.9);
      }
      a {
        color: #38bdf8;
      }
      nav {
        margin-bottom: 2rem;
      }
      header, footer {
        margin: 2rem 0;
        text-align: center;
        opacity: 0.8;
      }
      pre, code {
        font-family: "JetBrains Mono", "Fira Code", monospace;
        background: rgba(148, 163, 184, 0.1);
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
      }
      pre {
        padding: 1rem;
        overflow-x: auto;
      }
      @media (prefers-color-scheme: light) {
        body {
          background: #f8fafc;
          color: #0f172a;
        }
        main {
          background: #ffffff;
        }
      }
    </style>
  </head>
  <body>
    <main>
      {{{body}}}
    </main>
  </body>
</html>
